<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- The VPN itself needs no special permission; consent is granted through VpnService.prepare(). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 33+: without this the foreground notification is hidden. The tunnel still works. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Needed on API 30+ to list launchable apps in the bypass picker. Without
        it package visibility filtering hides them and the picker would show
        only Shieldly itself.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".SentinelApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sentinel"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".vpn.AdBlockVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">

            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>

            <!--
              Always-on VPN is intentionally not advertised yet: the service does
              not yet survive a reboot flow and we would rather show no option
              than a broken one.
            -->
            <meta-data
                android:name="android.net.VpnService.SUPPORTS_ALWAYS_ON"
                android:value="false" />

            <!-- Required by Android 14+ for the specialUse foreground service type. -->
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Local DNS filtering tunnel that must stay connected for the whole protection session." />
        </service>

        <!--
          Experimental, opt-in, and completely separate from the VPN service.
          Scope is fixed by res/xml/accessibility_service_config.xml: Facebook
          and Facebook Lite only. The system is the only thing that can enable
          it; the app can merely send the user to Accessibility settings.
        -->
        <service
            android:name=".cosmetic.FacebookAdHiderService"
            android:exported="true"
            android:label="@string/cosmetic_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">

            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>

</manifest>
